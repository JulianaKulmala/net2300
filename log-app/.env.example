# Environment Configuration for Log Application
# Copy this file to .env and update with your values

# Host IP address (use your Rocky Linux server IP)
# Example: HOST_IP=192.168.1.100
# Example: HOST_IP=10.0.0.50
HOST_IP=localhost

# Database Configuration (optional - defaults are set in docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=logdb
MYSQL_USER=logapp
MYSQL_PASSWORD=logapp123

# Backend Configuration
PORT=5000
NODE_ENV=production

# Frontend will automatically use: http://${HOST_IP}:5000/api
